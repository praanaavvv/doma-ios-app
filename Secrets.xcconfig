// Configuration settings file format documentation can be found at:
// https://developer.apple.com/documentation/xcode/adding-a-build-configuration-file-to-your-project

DYNAMIC_BASE_URL = https://app.dynamicauth.com/api/v0
DYNAMIC_RELAY_HOST = relay.dynamicauth.com
DYNAMIC_ENVIRONMENT_ID = bbba92fe-3138-4234-a015-2913c63db27f

// WalletConnect / Reown Relay configuration
// Use the public WalletConnect relay host and your dashboard project ID
WC_RELAY_HOST = relay.walletconnect.com
WC_PROJECT_ID = 260081759371d09f709e62d482295aaf

// Optionally expose a full relay URL if your networking layer expects it
// Example: wss://relay.walletconnect.com?projectId=$(WC_PROJECT_ID)&bundleId=$(PRODUCT_BUNDLE_IDENTIFIER)
WC_RELAY_URL= wss://$(WC_RELAY_HOST)/?projectId=$(WC_PROJECT_ID)
